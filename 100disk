#include "kv.grpc.pb.h"
#include <atomic>
#include <chrono>
#include <cstring>
#include <fstream>
#include <grpcpp/grpcpp.h>
#include <iostream>
#include <sstream>
#include <string>
#include <thread>
#include <vector>

int main(int argc, char **argv) {
  if (argc < 3) {
    std::cout << "Usage: ./load_client_clb <THREADS> <SECONDS> [SERVER_IP]" << std::endl;
    std::cout << "Example: ./load_client_clb 200 60 192.168.0.109" << std::endl;
    return 0;
  }

  int threads = std::stoi(argv[1]);
  int target_seconds = std::stoi(argv[2]);
  std::string server_ip = (argc >= 4) ? argv[3] : "127.0.0.1";

  // === Step 1: Target Multiple Backends directly ===
  // We use gRPC native ipv4 resolution to do client-side Round-Robin load
  // balancing. We bypass HAProxy entirely.
  std::string target = "ipv4:" + server_ip + ":50063," + server_ip + ":50064," +
                       server_ip + ":50065";
  std::cout << "[gRPC] Connecting to Multiple API Nodes (ClientLB/Insecure): "
            << target << std::endl;

  // We are bypassing SSL here to ensure we measure raw application throughput.
  auto channel_creds = grpc::InsecureChannelCredentials();

  // === Step 2: Configure load balancing ===
  grpc::ChannelArguments args;
  args.SetLoadBalancingPolicyName("round_robin");
  // Force a unique connection for the login stub
  args.SetInt("grpc.channel_id", -1);

  auto channel = grpc::CreateCustomChannel(target, channel_creds, args);
  auto stub = kv::KVService::NewStub(channel);

  // === Step 3: Login to get JWT ===
  grpc::ClientContext ctx;
  kv::LoginRequest login_req;
  login_req.set_api_key("initial-pass");
  login_req.set_client_id("clientlb-benchmark");
  kv::LoginResponse login_resp;
  grpc::Status status = stub->Login(&ctx, login_req, &login_resp);

  if (!status.ok()) {
    std::cerr << "gRPC Login Error: " << status.error_message()
              << " (Code: " << status.error_code() << ")" << std::endl;
    return 1;
  }

  std::string jwt = login_resp.jwt_token();
  if (jwt.empty()) {
    std::cerr << "Login failed! Token is empty." << std::endl;
    return 1;
  }

  std::atomic<long> successful_requests{0};
  std::atomic<long> failed_requests{0};
  std::atomic<long> total_latency_us{0};

  std::cout << "Target: Running for " << target_seconds << " seconds across " << threads
            << " threads." << std::endl;

  // === Step 3.5: Create Stub Pool to avoid contention ===
  int stub_count = 64; // Increase pool size for massive throughput
  std::vector<std::unique_ptr<kv::KVService::Stub>> stub_pool;
  for (int i = 0; i < stub_count; i++) {
    grpc::ChannelArguments pool_args;
    pool_args.SetLoadBalancingPolicyName("round_robin");
    // CRITICAL: Force gRPC to open a UNIQUE TCP connection instead of reusing
    // the cached one
    pool_args.SetInt("grpc.channel_id", i);

    auto chan = grpc::CreateCustomChannel(target, channel_creds, pool_args);
    stub_pool.push_back(kv::KVService::NewStub(chan));
  }

  std::cout << "Pre-generating keys..." << std::endl;
  std::vector<std::string> pregen_keys;
  for (int i = 0; i < 1000000; i++) { // Pregen 1 Million keys
    pregen_keys.push_back("heavy_key_" + std::to_string(i));
  }

  // Create a 2MB string. This safely avoids gRPC's default 4MB strict limit!
  std::string heavy_value(2 * 1024 * 1024, 'X');

  std::cout << "Starting benchmark..." << std::endl;

  auto start_time = std::chrono::high_resolution_clock::now();

  // === Step 4: Fire Requests ===
  std::vector<std::thread> pool;
  for (int i = 0; i < threads; i++) {
    pool.emplace_back([&, i]() {
      long local_success = 0;
      long local_failed = 0;
      long local_latency = 0;

      auto &stub = stub_pool[i % stub_pool.size()];
      
      long j = 0;
      auto thread_start = std::chrono::steady_clock::now();
      
      while (true) {
        auto now = std::chrono::steady_clock::now();
        if (std::chrono::duration_cast<std::chrono::seconds>(now - thread_start).count() >= target_seconds) {
            break;
        }

        grpc::ClientContext call_ctx;
        call_ctx.AddMetadata("authorization", jwt);
        kv::SingleRequest req;
        req.set_type(kv::PUT);
        
        // Use a 100% unique key for every single request so RocksDB NEVER deletes it!
        req.set_key("heavy_key_thread_" + std::to_string(i) + "_req_" + std::to_string(j++));

        req.set_value(heavy_value); // 2MB Payload
        kv::SingleResponse resp;

        auto req_start = std::chrono::high_resolution_clock::now();
        grpc::Status status = stub->ExecuteSingle(&call_ctx, req, &resp);
        auto req_end = std::chrono::high_resolution_clock::now();

        if (status.ok()) {
          local_success++;
          local_latency +=
              std::chrono::duration_cast<std::chrono::microseconds>(req_end -
                                                                    req_start)
                  .count();
        } else {
          local_failed++;
        }
      }
      successful_requests += local_success;
      failed_requests += local_failed;
      total_latency_us += local_latency;
    });
  }
  for (auto &t : pool)
    t.join();

  auto end_time = std::chrono::high_resolution_clock::now();
  std::chrono::duration<double> elapsed = end_time - start_time;

  double rps = successful_requests / elapsed.count();
  double avg_latency =
      successful_requests > 0
          ? (double)total_latency_us / successful_requests / 1000.0
          : 0;

  std::cout << "\n--- Benchmark Results ---" << std::endl;
  std::cout << "Target Time:     " << target_seconds << " seconds" << std::endl;
  std::cout << "Successful:      " << successful_requests << std::endl;
  std::cout << "Dropped/Failed:  " << failed_requests << std::endl;
  std::cout << "Total Time:      " << elapsed.count() << " seconds"
            << std::endl;
  std::cout << "Throughput:      " << rps << " requests/sec" << std::endl;
  std::cout << "Avg Latency:     " << avg_latency << " ms" << std::endl;
  std::cout << "-------------------------\n" << std::endl;

  return 0;
}
